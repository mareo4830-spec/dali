# Configuración de Firebase para Dalí Bar
# Sustituye estos valores con los de tu proyecto en Firebase Console (Configuración del proyecto > Tus apps > Web SDK)
VITE_FIREBASE_API_KEY=AIzaSyTuApiKeyAqui
VITE_FIREBASE_AUTH_DOMAIN=dali-bar.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=dali-bar
VITE_FIREBASE_STORAGE_BUCKET=dali-bar.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
